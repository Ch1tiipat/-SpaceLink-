# Environment template — apps/api
# Copy to .env and fill in real values from the Supabase dashboard.
# PLACEHOLDERS ONLY IN THIS FILE. Never commit a real key, password, or
# connection string here. See CLAUDE.md §2.5 and §9.

# Supabase pooled connection — port 6543. Used by the running app.
# Real form: postgresql://<user>:<password>@<host>:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# Supabase direct/session connection — port 5432. Used by migrations only.
# Real form: postgresql://<user>:<password>@<host>:5432/postgres
DIRECT_URL=

# Supabase project URL, used to reach Auth and Storage.
SUPABASE_URL=

# Backend only — bypasses all row-level security. Never put this in apps/web.
SUPABASE_SERVICE_ROLE_KEY=

# --- Token verification: set exactly one of the next two ---

# For projects using asymmetric JWT signing keys. Copy from the Supabase
# dashboard (Project Settings -> API -> JWT Keys). Only one of
# SUPABASE_JWKS_URL or SUPABASE_JWT_SECRET is required.
# Real form: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# For projects still using the legacy HS256 secret.
SUPABASE_JWT_SECRET=

# --- Optional. Leave blank to use the default ---

# Allowed frontend origin. Blank allows any origin, which suits local dev.
CORS_ORIGIN=

# development | production | test. Defaults to development.
NODE_ENV=

# Port the API listens on.
PORT=3000

# Slip verification provider: mock | manual | slipok. Defaults to mock.
#   mock   — no network call, approves or rejects everything. Development only.
#   manual — always ERROR; an ORG_ADMIN confirms by hand via isPaymentExempt.
#   slipok — the real SlipOK client. NOT IMPLEMENTED YET: the app will refuse
#            to boot with this value. See src/slips/README.md.
SLIP_VERIFIER=mock

# Only used when SLIP_VERIFIER=mock: always-verified | always-invalid.
# Defaults to always-verified.
SLIP_VERIFIER_MODE=always-verified

# Booth recommendation engine: rule | gemini. Defaults to rule.
#   rule   — reads the database only. No API key, no cost, works offline.
#   gemini — Gemini Flash / Flash-Lite. NOT IMPLEMENTED YET: the app will refuse
#            to boot with this value. See src/ai/README.md.
ZONE_RECOMMENDER=rule
