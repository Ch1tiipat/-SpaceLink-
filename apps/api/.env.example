# apps/api environment template. Copy to .env and insert real values locally.
# Never commit real credentials.

DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Set exactly one.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=

NODE_ENV=
CORS_ORIGIN=
PORT=3000

# Optional web push. Set all three together to enable VAPID delivery.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# mock | manual | slipok
SLIP_VERIFIER=mock
SLIP_VERIFIER_MODE=always-verified

# Required only when SLIP_VERIFIER=slipok.
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=

# rule | gemini
ZONE_RECOMMENDER=rule

# Required only when ZONE_RECOMMENDER=gemini.
GEMINI_API_KEY=

# Flash / Flash-Lite only. Pro models are rejected at boot.
GEMINI_MODEL=gemini-3.5-flash-lite

# rule | gemini. Set to gemini in the deployed API to enable the support chat.
SUPPORT_ASSISTANT=rule

# The support chat uses the stable Gemini 3.6 Flash model.
GEMINI_SUPPORT_MODEL=gemini-3.6-flash
