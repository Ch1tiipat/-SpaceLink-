# Public URL of the NestJS API. This value is embedded in the browser bundle.
NEXT_PUBLIC_API_URL=

# Supabase project URL, copied from the dashboard. Also embedded in the bundle.
NEXT_PUBLIC_SUPABASE_URL=

# The anon (publishable) key — the only Supabase key that may reach a browser.
# It is row-level-security scoped and is meant to be public.
#
# Never put SUPABASE_SERVICE_ROLE_KEY here, or in any other NEXT_PUBLIC_*
# variable. It bypasses row-level security entirely and is backend-only
# (AGENTS.md §7, §14.3).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public VAPID key used by the browser when subscribing to Web Push.
# This key is safe to expose; the matching private key stays in the API only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
